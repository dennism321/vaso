# Database — the only required secret. The site seeds its initial content
# (articles + sample reviews) automatically on first run.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Password for the admin panel at /admin. REQUIRED for admin access.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. A random string used to sign admin session cookies.
# If left empty, a derived value based on ADMIN_PASSWORD is used.
ADMIN_SESSION_SECRET=

# Optional. Public URL of the site, used in SEO metadata and sitemap.
# Defaults to https://vasopantazi.gr in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=
